{
  "name": "student-management-system-nodejs",
  "version": "2.0.0",
  "description": "Enterprise-grade refactoring of Student Management System from Python to Node.js and Express with interactive OpenAPI / Swagger UI documentation and academic Next.js dashboard.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/student.test.js",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:start": "npm run start --prefix frontend",
    "frontend:install": "npm install --prefix frontend"
  },
  "keywords": [
    "student-management-system",
    "express",
    "nodejs",
    "nextjs",
    "react",
    "swagger",
    "openapi",
    "rest-api",
    "academic-project"
  ],
  "author": "Computer Science & Engineering Student Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
